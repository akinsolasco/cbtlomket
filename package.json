{
  "name": "lomket-cbt",
  "version": "1.0.1",
  "private": true,
  "author": "Lomket",
  "description": "Lomket CBT local-network examination server and admin console.",
  "main": "desktop/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/akinsolasco/cbtlomket.git"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js --host 0.0.0.0 --port 4090",
    "desktop": "electron .",
    "admin": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always",
    "start:lan": "node server/index.js --host 0.0.0.0 --port 4090",
    "dev": "node server/index.js --host 0.0.0.0 --port 4090",
    "test": "node scripts/smoke-test.js",
    "reset-admin": "node scripts/reset-admin-password.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lomket.cbt",
    "productName": "Lomket CBT Admin",
    "artifactName": "Lomket-CBT-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lomket CBT Admin",
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "akinsolasco",
        "repo": "cbtlomket",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cbt",
    "exam",
    "local-network",
    "lomket"
  ],
  "license": "UNLICENSED"
}
